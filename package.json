{
  "name": "zxn-motion-graphics",
  "private": true,
  "description": "Deterministic, frame-addressable motion graphics in React. The open-source film stack behind ZXN Studio.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run docs:verify",
    "docs:verify": "node scripts/docs-verify.mjs"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "culori": "^4.0.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.28.1",
    "gsap": "^3.15.0",
    "happy-dom": "^20.14.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplex-noise": "^4.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
